    <!-- Custom Toast Notification -->
    <div id="toast" class="fixed bottom-5 right-5 z-50 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <div id="toastContent" class="flex items-center space-x-3 px-4 py-3 bg-slate-900 text-white rounded-xl shadow-xl text-sm border border-slate-800">
            <i id="toastIcon" class="fa-solid fa-circle-check text-emerald-400 text-base"></i>
            <span id="toastMessage">Pesan Notifikasi</span>
        </div>
    </div>

    <script>
        // Global Application State
        let currentRole = 'admin';
        let gasWebAppUrl = localStorage.getItem('gasWebAppUrl') || 'https://script.google.com/macros/s/AKfycbxikCH_viClVkj12nSlohPEcS3lJbLHg4Ud47v5qvO2c1A9dUSrIdoX34YQjWN696P9Aw/exec'; 

        let instructorsData = [];
        let studentsData = [];
        let scheduleData = [];

        window.addEventListener('DOMContentLoaded', () => {
            populateInstructorDropdowns();
            populateRoomFilter();
            renderTable();
            updateStats();
            
            if (gasWebAppUrl) {
                document.getElementById('syncStatusBadge').classList.remove('hidden');
                fetchFromGoogleSheets();
            }
        });

        function openSheetsModal() {
            document.getElementById('gasUrlInput').value = gasWebAppUrl;
            document.getElementById('sheetsModal').classList.remove('hidden');
        }

        function closeSheetsModal() {
            document.getElementById('sheetsModal').classList.add('hidden');
        }

        function saveSheetsUrl() {
            const urlInput = document.getElementById('gasUrlInput').value.trim();
            gasWebAppUrl = urlInput;
            localStorage.setItem('gasWebAppUrl', gasWebAppUrl);
            closeSheetsModal();
            
            if (gasWebAppUrl) {
                document.getElementById('syncStatusBadge').classList.remove('hidden');
                fetchFromGoogleSheets();
            } else {
                document.getElementById('syncStatusBadge').classList.add('hidden');
            }
            showToast("URL Google Sheets berhasil disimpan!", "success");
        }

        async function fetchFromGoogleSheets() {
            if (!gasWebAppUrl) {
                showToast("Silakan tentukan URL Google Apps Script terlebih dahulu", "error");
                openSheetsModal();
                return;
            }

            try {
                showToast("Mengambil data dari Google Sheets...", "info");
                const response = await fetch(`${gasWebAppUrl}?action=getInitialData`);
                const data = await response.json();

                if (data.schedules) scheduleData = data.schedules;
                if (data.instructors) instructorsData = data.instructors;
                if (data.students) studentsData = data.students;

                populateInstructorDropdowns();
                populateRoomFilter();
                renderTable();
                updateStats();
                showToast("Data dari Google Sheets berhasil dimuat!", "success");
            } catch (err) {
                console.error("Gagal sinkronisasi Google Sheets:", err);
                showToast("Gagal mengambil data dari Google Sheets", "error");
            }
        }

        // Menyimpan Seluruh Data Perubahan ke Google Sheets (POST)
        async function saveToGoogleSheets(silent = false) {
            if (!gasWebAppUrl) {
                if (!silent) {
                    showToast("Hubungkan Google Sheets via tombol Integrasi lebih dulu", "error");
                    openSheetsModal();
                }
                return;
            }

            if (!silent) showToast("Menyimpan ke Google Sheets...", "info");
            
            document.getElementById('syncStatusText').innerText = "Menyimpan ke Sheet...";

            const payload = {
                action: "saveAll",
                schedules: scheduleData,
                instructors: instructorsData,
                students: studentsData
            };

            try {
                const response = await fetch(gasWebAppUrl, {
                    method: 'POST',
                    body: JSON.stringify(payload)
                });
                const result = await response.json();

                if (result.status === "success") {
                    document.getElementById('syncStatusText').innerText = "Tersambung & Tersimpan";
                    if (!silent) showToast("Data berhasil tersimpan ke Google Sheets!", "success");
                } else {
                    document.getElementById('syncStatusText').innerText = "Gagal Menyimpan";
                    showToast("Peringatan: " + (result.message || "Gagal menyimpan"), "error");
                }
            } catch (err) {
                console.error("Error menyimpan data:", err);
                document.getElementById('syncStatusText').innerText = "Koneksi Terputus";
                if (!silent) showToast("Gagal terhubung ke Google Sheets!", "error");
            }
        }

        function switchRole(role) {
            currentRole = role;
            const adminBtn = document.getElementById('roleAdminBtn');
            const instructorBtn = document.getElementById('roleInstructorBtn');
            const roleBadge = document.getElementById('roleBadge');
            const roleLabelText = document.getElementById('roleLabelText');
            const adminMasterButtons = document.getElementById('adminMasterButtons');

            if (role === 'admin') {
                adminBtn.className = "px-3 py-1 rounded-md font-semibold transition-all bg-indigo-600 text-white shadow-sm";
                instructorBtn.className = "px-3 py-1 rounded-md font-semibold text-slate-300 hover:text-white transition-all";
                roleBadge.className = "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2.5 py-1 rounded-full font-medium flex items-center gap-1.5";
                roleLabelText.innerText = "Akses Admin (Full)";
                adminMasterButtons.classList.remove('hidden');
                showToast("Beralih ke Mode Admin (Akses Penuh)", "info");
            } else {
                instructorBtn.className = "px-3 py-1 rounded-md font-semibold transition-all bg-indigo-600 text-white shadow-sm";
                adminBtn.className = "px-3 py-1 rounded-md font-semibold text-slate-300 hover:text-white transition-all";
                roleBadge.className = "bg-amber-500/10 text-amber-400 border border-amber-500/20 text-xs px-2.5 py-1 rounded-full font-medium flex items-center gap-1.5";
                roleLabelText.innerText = "Akses Instruktur";
                adminMasterButtons.classList.add('hidden');
                showToast("Beralih ke Mode Instruktur", "info");
            }

            renderTable();
        }

        function populateInstructorDropdowns() {
            const insSelect = document.getElementById('instructor');
            const p1Select = document.getElementById('proctor1');
            const p2Select = document.getElementById('proctor2');

            insSelect.innerHTML = '<option value="">-- Pilih Instruktur --</option>';
            p1Select.innerHTML = '<option value="">-- Pilih Pengawas 1 --</option>';
            p2Select.innerHTML = '<option value="-">- Tidak Ada Pengawas 2 -</option>';

            instructorsData.forEach(ins => {
                const opt1 = document.createElement('option');
                opt1.value = ins.name;
                opt1.innerText = ins.name;
                insSelect.appendChild(opt1);

                const opt2 = document.createElement('option');
                opt2.value = ins.name;
                opt2.innerText = ins.name;
                p1Select.appendChild(opt2);

                const opt3 = document.createElement('option');
                opt3.value = ins.name;
                opt3.innerText = ins.name;
                p2Select.appendChild(opt3);
            });
        }

        // Instructor Master Handlers
        function openInstructorModal() {
            if (currentRole !== 'admin') {
                showToast("Hanya Admin yang dapat mengelola Instruktur", "error");
                return;
            }
            renderInstructorTable();
            document.getElementById('instructorModal').classList.remove('hidden');
        }

        function closeInstructorModal() {
            document.getElementById('instructorModal').classList.add('hidden');
        }

        function renderInstructorTable() {
            const tbody = document.getElementById('instructorTableBody');
            tbody.innerHTML = '';

            instructorsData.forEach(ins => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-2 px-3 font-mono text-slate-500">${ins.nidn}</td>
                    <td class="py-2 px-3 font-semibold text-slate-800">${ins.name}</td>
                    <td class="py-2 px-3 text-slate-600">${ins.email}</td>
                    <td class="py-2 px-3 text-center">
                        <button onclick="editInstructor('${ins.id}')" class="p-1 text-indigo-600 hover:bg-indigo-50 rounded"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteInstructor('${ins.id}')" class="p-1 text-rose-600 hover:bg-rose-50 rounded"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleInstructorSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('editInstructorId').value;
            const nidn = document.getElementById('insNidn').value;
            const name = document.getElementById('insName').value;
            const email = document.getElementById('insEmail').value;

            if (editId) {
                const idx = instructorsData.findIndex(i => i.id === editId);
                if (idx !== -1) {
                    instructorsData[idx] = { ...instructorsData[idx], nidn, name, email };
                }
            } else {
                const newIns = { id: 'INS-' + Date.now(), nidn, name, email };
                instructorsData.push(newIns);
            }

            resetInstructorForm();
            renderInstructorTable();
            populateInstructorDropdowns();
            saveToGoogleSheets();
        }

        function editInstructor(id) {
            const ins = instructorsData.find(i => i.id === id);
            if (!ins) return;
            document.getElementById('editInstructorId').value = ins.id;
            document.getElementById('insNidn').value = ins.nidn;
            document.getElementById('insName').value = ins.name;
            document.getElementById('insEmail').value = ins.email;
            document.getElementById('instructorFormTitle').innerText = "Edit Data Instruktur";
        }

        function deleteInstructor(id) {
            instructorsData = instructorsData.filter(i => i.id !== id);
            renderInstructorTable();
            populateInstructorDropdowns();
            saveToGoogleSheets();
        }

        function resetInstructorForm() {
            document.getElementById('instructorForm').reset();
            document.getElementById('editInstructorId').value = "";
            document.getElementById('instructorFormTitle').innerText = "Tambah Instruktur Baru";
        }

        // Student Master Handlers
        function openStudentModal() {
            if (currentRole !== 'admin') {
                showToast("Hanya Admin yang dapat mengelola Peserta Kursus", "error");
                return;
            }
            renderStudentTable();
            document.getElementById('studentModal').classList.remove('hidden');
        }

        function closeStudentModal() {
            document.getElementById('studentModal').classList.add('hidden');
        }

        function renderStudentTable() {
            const tbody = document.getElementById('studentTableBody');
            tbody.innerHTML = '';

            studentsData.forEach(stu => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50";
                tr.innerHTML = `
                    <td class="py-2 px-3 font-mono text-slate-500">${stu.nim}</td>
                    <td class="py-2 px-3 font-semibold text-slate-800">${stu.name}</td>
                    <td class="py-2 px-3"><span class="bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-mono">${stu.group}</span></td>
                    <td class="py-2 px-3 text-slate-600">${stu.email || '-'}</td>
                    <td class="py-2 px-3 text-center">
                        <button onclick="editStudent('${stu.id}')" class="p-1 text-emerald-600 hover:bg-emerald-50 rounded"><i class="fa-solid fa-pen"></i></button>
                        <button onclick="deleteStudent('${stu.id}')" class="p-1 text-rose-600 hover:bg-rose-50 rounded"><i class="fa-solid fa-trash"></i></button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function handleStudentSubmit(e) {
            e.preventDefault();
            const editId = document.getElementById('editStudentId').value;
            const nim = document.getElementById('stuNim').value;
            const name = document.getElementById('stuName').value;
            const group = document.getElementById('stuGroup').value;
            const email = document.getElementById('stuEmail').value;

            if (editId) {
                const idx = studentsData.findIndex(s => s.id === editId);
                if (idx !== -1) {
                    studentsData[idx] = { ...studentsData[idx], nim, name, group, email };
                }
            } else {
                const newStu = { id: 'STU-' + Date.now(), nim, name, group, email };
                studentsData.push(newStu);
            }

            resetStudentForm();
            renderStudentTable();
            saveToGoogleSheets();
        }

        function editStudent(id) {
            const stu = studentsData.find(s => s.id === id);
            if (!stu) return;
            document.getElementById('editStudentId').value = stu.id;
            document.getElementById('stuNim').value = stu.nim;
            document.getElementById('stuName').value = stu.name;
            document.getElementById('stuGroup').value = stu.group;
            document.getElementById('stuEmail').value = stu.email || "";
            document.getElementById('studentFormTitle').innerText = "Edit Data Peserta";
        }

        function deleteStudent(id) {
            studentsData = studentsData.filter(s => s.id !== id);
            renderStudentTable();
            saveToGoogleSheets();
        }

        function resetStudentForm() {
            document.getElementById('studentForm').reset();
            document.getElementById('editStudentId').value = "";
            document.getElementById('studentFormTitle').innerText = "Tambah Peserta Baru";
        }

        // Student Picker Handlers
        function openSelectStudentPicker() {
            renderStudentPickerList();
            document.getElementById('studentPickerModal').classList.remove('hidden');
        }

        function closeStudentPickerModal() {
            document.getElementById('studentPickerModal').classList.add('hidden');
        }

        function renderStudentPickerList() {
            const container = document.getElementById('pickerList');
            const search = (document.getElementById('pickerSearch').value || '').toLowerCase();
            container.innerHTML = '';

            const filtered = studentsData.filter(s => 
                s.name.toLowerCase().includes(search) || 
                s.nim.toLowerCase().includes(search) || 
                s.group.toLowerCase().includes(search)
            );

            if (filtered.length === 0) {
                container.innerHTML = '<p class="text-slate-400 italic text-center py-4">Tidak ada peserta ditemukan.</p>';
                return;
            }

            filtered.forEach(s => {
                const div = document.createElement('label');
                div.className = "flex items-center space-x-3 p-2 bg-slate-50 border border-slate-200 rounded-lg cursor-pointer hover:bg-slate-100 transition-colors";
                div.innerHTML = `
                    <input type="checkbox" value="${s.nim} - ${s.name} - ${s.group}" class="stu-checkbox text-indigo-600 rounded focus:ring-indigo-500">
                    <div class="flex-1">
                        <p class="font-semibold text-slate-800">${s.name} <span class="font-normal text-slate-500">(${s.nim})</span></p>
                        <p class="text-[10px] text-slate-400">Grup: ${s.group}</p>
                    </div>
                `;
                container.appendChild(div);
            });
        }

        function applySelectedStudents() {
            const checkboxes = document.querySelectorAll('.stu-checkbox:checked');
            const selectedText = Array.from(checkboxes).map(cb => cb.value).join('\n');
            
            const area = document.getElementById('pesertaTitipan');
            if (area.value.trim() !== '' && selectedText) {
                area.value = area.value.trim() + '\n' + selectedText;
            } else if (selectedText) {
                area.value = selectedText;
            }

            closeStudentPickerModal();
            showToast(`${checkboxes.length} peserta ditambahkan ke draf jadwal`, "success");
        }

        function populateRoomFilter() {
            const filterRoom = document.getElementById('filterRoom');
            const rooms = [...new Set(scheduleData.map(item => item.room))];
            
            filterRoom.innerHTML = '<option value="ALL">Semua Ruangan</option>';
            rooms.forEach(r => {
                if(r) {
                    const opt = document.createElement('option');
                    opt.value = r;
                    opt.innerText = r;
                    filterRoom.appendChild(opt);
                }
            });
        }

        function renderTable() {
            const tbody = document.getElementById('scheduleTableBody');
            const emptyState = document.getElementById('emptyState');
            tbody.innerHTML = '';

            const filteredData = getFilteredData();

            if (filteredData.length === 0) {
                emptyState.classList.remove('hidden');
                return;
            } else {
                emptyState.classList.add('hidden');
            }

            filteredData.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50/80 transition-colors border-b border-slate-100";

                const titipanList = item.pesertaTitipan ? item.pesertaTitipan.split('\n').filter(line => line.trim() !== '') : [];
                const titipanBadge = titipanList.length > 0 
                    ? `<button onclick="openDetailModal('${item.id}')" class="px-2.5 py-1 bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 rounded-full font-semibold text-xs flex items-center gap-1 mx-auto transition-colors"><i class="fa-solid fa-users text-[10px]"></i> ${titipanList.length} Orang</button>`
                    : `<span class="text-slate-300 text-xs text-center block">-</span>`;

                const isFinal = item.jenisTest === 'Final Test';
                const jenisBadge = isFinal 
                    ? `<span class="bg-indigo-50 text-indigo-700 border border-indigo-200 px-2 py-0.5 rounded-md text-[11px] font-semibold">${item.jenisTest}</span>`
                    : `<span class="bg-amber-50 text-amber-700 border border-amber-200 px-2 py-0.5 rounded-md text-[11px] font-semibold">${item.jenisTest}</span>`;

                tr.innerHTML = `
                    <td class="py-3.5 px-4 font-mono text-xs text-slate-400 text-center">${index + 1}</td>
                    <td class="py-3.5 px-4">
                        <div class="flex flex-col">
                            <div class="flex items-center space-x-2">
                                <span class="font-bold text-slate-800">${item.idGrup}</span>
                                ${jenisBadge}
                            </div>
                            <span class="text-xs text-slate-500 mt-0.5 line-clamp-1">${item.description || 'Tidak ada deskripsi'}</span>
                        </div>
                    </td>
                    <td class="py-3.5 px-4 font-medium text-slate-700">
                        <div class="flex items-center space-x-1.5">
                            <i class="fa-solid fa-user-tie text-slate-400 text-xs"></i>
                            <span>${item.instructor}</span>
                        </div>
                    </td>
                    <td class="py-3.5 px-4">
                        <div class="text-xs space-y-0.5">
                            <div class="font-medium text-slate-800">
                                <i class="fa-regular fa-calendar text-indigo-500 mr-1"></i> ${formatDate(item.startDate)}
                            </div>
                            <div class="text-slate-500 font-mono">
                                <i class="fa-regular fa-clock text-slate-400 mr-1"></i> ${item.startTime} - ${item.endTime}
                            </div>
                        </div>
                    </td>
                    <td class="py-3.5 px-4">
                        <span class="bg-slate-100 text-slate-700 text-xs px-2.5 py-1 rounded-lg border border-slate-200 font-medium inline-block">
                            <i class="fa-solid fa-location-dot text-rose-500 mr-1"></i> ${item.room}
                        </span>
                    </td>
                    <td class="py-3.5 px-4 text-xs space-y-0.5">
                        <div class="text-slate-800"><span class="text-slate-400">P1:</span> ${item.proctor1}</div>
                        ${item.proctor2 ? `<div class="text-slate-500"><span class="text-slate-400">P2:</span> ${item.proctor2}</div>` : ''}
                    </td>
                    <td class="py-3.5 px-4 text-center">
                        ${titipanBadge}
                    </td>
                    <td class="py-3.5 px-4 text-center">
                        <div class="flex items-center justify-center space-x-1">
                            <button onclick="editSchedule('${item.id}')" title="Edit Jadwal" class="p-1.5 text-slate-500 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-colors">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </button>
                            <button onclick="duplicateSchedule('${item.id}')" title="Duplikat Jadwal" class="p-1.5 text-slate-500 hover:text-emerald-600 hover:bg-emerald-50 rounded-lg transition-colors">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                            ${currentRole === 'admin' ? `
                            <button onclick="deleteSchedule('${item.id}')" title="Hapus" class="p-1.5 text-slate-500 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>` : ''}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function getFilteredData() {
            const search = document.getElementById('searchInput').value.toLowerCase();
            const filterJenis = document.getElementById('filterJenisTest').value;
            const filterRoom = document.getElementById('filterRoom').value;

            return scheduleData.filter(item => {
                const matchSearch = (
                    item.idGrup.toLowerCase().includes(search) ||
                    item.instructor.toLowerCase().includes(search) ||
                    item.room.toLowerCase().includes(search) ||
                    item.proctor1.toLowerCase().includes(search)
                );
                const matchJenis = filterJenis === 'ALL' || item.jenisTest === filterJenis;
                const matchRoom = filterRoom === 'ALL' || item.room === filterRoom;

                return matchSearch && matchJenis && matchRoom;
            });
        }

        function applyFilters() {
            renderTable();
        }

        function updateStats() {
            document.getElementById('statTotalJadwal').innerText = scheduleData.length;
            document.getElementById('statFinalTest').innerText = scheduleData.filter(d => d.jenisTest === 'Final Test').length;
            document.getElementById('statRemedialTest').innerText = scheduleData.filter(d => d.jenisTest === 'Remedial Test').length;

            let totalTitipan = 0;
            scheduleData.forEach(d => {
                if (d.pesertaTitipan) {
                    const lines = d.pesertaTitipan.split('\n').filter(l => l.trim() !== '');
                    totalTitipan += lines.length;
                }
            });
            document.getElementById('statPesertaTitipan').innerText = totalTitipan;
        }

        function openFormModal(isEdit = false) {
            populateInstructorDropdowns();
            document.getElementById('formModal').classList.remove('hidden');
            if (!isEdit) {
                document.getElementById('modalTitle').innerText = "Tambah Jadwal Tes Baru";
                document.getElementById('scheduleForm').reset();
                document.getElementById('editScheduleId').value = "";
                const today = new Date().toISOString().split('T')[0];
                document.getElementById('startDate').value = today;
                document.getElementById('endDate').value = today;
            }
        }

        function closeFormModal() {
            document.getElementById('formModal').classList.add('hidden');
        }

        function handleFormSubmit(e) {
            e.preventDefault();

            const editId = document.getElementById('editScheduleId').value;
            const formData = {
                idGrup: document.getElementById('idGrup').value,
                jenisTest: document.getElementById('jenisTest').value,
                description: document.getElementById('description').value,
                instructor: document.getElementById('instructor').value,
                startDate: document.getElementById('startDate').value,
                startTime: document.getElementById('startTime').value,
                endDate: document.getElementById('endDate').value,
                endTime: document.getElementById('endTime').value,
                room: document.getElementById('room').value,
                proctor1: document.getElementById('proctor1').value,
                proctor2: document.getElementById('proctor2').value,
                pesertaTitipan: document.getElementById('pesertaTitipan').value
            };

            if (editId) {
                const index = scheduleData.findIndex(item => item.id === editId);
                if (index !== -1) {
                    scheduleData[index] = { ...scheduleData[index], ...formData };
                }
            } else {
                const newObj = {
                    id: 'SCH-' + Math.floor(100 + Math.random() * 900),
                    ...formData
                };
                scheduleData.push(newObj);
            }

            populateRoomFilter();
            renderTable();
            updateStats();
            closeFormModal();
            saveToGoogleSheets();
        }

        function editSchedule(id) {
            const item = scheduleData.find(d => d.id === id);
            if (!item) return;

            document.getElementById('editScheduleId').value = item.id;
            document.getElementById('modalTitle').innerText = "Edit Jadwal Tes (" + item.idGrup + ")";
            
            document.getElementById('idGrup').value = item.idGrup;
            document.getElementById('jenisTest').value = item.jenisTest;
            document.getElementById('description').value = item.description || "";
            document.getElementById('instructor').value = item.instructor;
            document.getElementById('startDate').value = item.startDate;
            document.getElementById('startTime').value = item.startTime;
            document.getElementById('endDate').value = item.endDate;
            document.getElementById('endTime').value = item.endTime;
            document.getElementById('room').value = item.room;
            document.getElementById('proctor1').value = item.proctor1;
            document.getElementById('proctor2').value = item.proctor2 || "";
            document.getElementById('pesertaTitipan').value = item.pesertaTitipan || "";

            openFormModal(true);
        }

        function duplicateSchedule(id) {
            const item = scheduleData.find(d => d.id === id);
            if (!item) return;

            const duplicated = {
                ...item,
                id: 'SCH-' + Math.floor(100 + Math.random() * 900),
                idGrup: item.idGrup + " (Copy)"
            };

            scheduleData.push(duplicated);
            renderTable();
            updateStats();
            saveToGoogleSheets();
        }

        function deleteSchedule(id) {
            if (currentRole !== 'admin') {
                showToast("Hanya Admin yang dapat menghapus jadwal!", "error");
                return;
            }

            scheduleData = scheduleData.filter(d => d.id !== id);
            populateRoomFilter();
            renderTable();
            updateStats();
            saveToGoogleSheets();
        }

        function openDetailModal(id) {
            const item = scheduleData.find(d => d.id === id);
            if (!item) return;

            document.getElementById('detailIdGrup').innerText = item.idGrup;
            document.getElementById('detailDescription').innerText = item.description || "Tidak ada rincian tambahan.";
            document.getElementById('detailInstructor').innerText = item.instructor;
            document.getElementById('detailRoom').innerText = item.room;
            document.getElementById('detailProctor1').innerText = item.proctor1;
            document.getElementById('detailProctor2').innerText = item.proctor2 || "-";

            const isFinal = item.jenisTest === 'Final Test';
            document.getElementById('detailEventBadge').innerHTML = isFinal 
                ? `<span class="bg-indigo-100 text-indigo-700 font-bold px-2.5 py-1 rounded-md text-xs">${item.jenisTest}</span>`
                : `<span class="bg-amber-100 text-amber-700 font-bold px-2.5 py-1 rounded-md text-xs">${item.jenisTest}</span>`;

            const listContainer = document.getElementById('detailPesertaList');
            listContainer.innerHTML = '';

            const lines = item.pesertaTitipan ? item.pesertaTitipan.split('\n').filter(l => l.trim() !== '') : [];
            document.getElementById('detailPesertaCount').innerText = `${lines.length} Peserta`;

            if (lines.length === 0) {
                listContainer.innerHTML = `<span class="text-slate-400 italic font-sans">Tidak ada peserta titipan untuk grup ini.</span>`;
            } else {
                lines.forEach((line, i) => {
                    const row = document.createElement('div');
                    row.className = "flex items-center justify-between bg-white p-2 rounded border border-slate-200/60";
                    row.innerHTML = `<span>${i + 1}. ${line}</span>`;
                    listContainer.appendChild(row);
                });
            }

            document.getElementById('detailModal').classList.remove('hidden');
        }

        function closeDetailModal() {
            document.getElementById('detailModal').classList.add('hidden');
        }

        function checkConflicts() {
            let conflicts = [];

            for (let i = 0; i < scheduleData.length; i++) {
                for (let j = i + 1; j < scheduleData.length; j++) {
                    const a = scheduleData[i];
                    const b = scheduleData[j];

                    if (a.startDate === b.startDate) {
                        if (a.startTime < b.endTime && a.endTime > b.startTime) {
                            if (a.room === b.room) {
                                conflicts.push(`Bentrok Ruangan (${a.room}): Grup ${a.idGrup} dan ${b.idGrup} pada jam ${a.startTime}-${a.endTime}`);
                            }
                            if (a.proctor1 === b.proctor1 && a.proctor1 !== '') {
                                conflicts.push(`Bentrok Pengawas (${a.proctor1}): Grup ${a.idGrup} dan ${b.idGrup}`);
                            }
                        }
                    }
                }
            }

            if (conflicts.length > 0) {
                showToast(`Ditemukan ${conflicts.length} potensi bentrok!`, "error");
                setTimeout(() => {
                    alert("PERINGATAN BENTROK JADWAL:\n\n" + conflicts.join("\n\n"));
                }, 300);
            } else {
                showToast("Tidak ada jadwal yang bentrok. Semua aman!", "success");
            }
        }

        function openAiModal() {
            document.getElementById('aiModal').classList.remove('hidden');
            document.getElementById('aiOutputContainer').classList.add('hidden');
        }

        function closeAiModal() {
            document.getElementById('aiModal').classList.add('hidden');
        }

        async function runAiAssistant() {
            const action = document.getElementById('aiActionType').value;
            const btn = document.getElementById('aiGenerateBtn');
            const outputBox = document.getElementById('aiOutput');
            const outputContainer = document.getElementById('aiOutputContainer');

            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Memproses...`;

            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const systemPrompt = "Anda adalah Asisten Administrasi Kursus Bahasa Inggris ELPT yang profesional, ramah, dan teliti.";
            let userQuery = "";

            if (action === 'announcement') {
                userQuery = `Buatkan draf pengumuman jadwal tes ELPT resmi dalam Bahasa Indonesia yang rapi untuk dibagikan ke grup WhatsApp/Email siswa berdasarkan data berikut: ${JSON.stringify(scheduleData, null, 2)}`;
            } else if (action === 'summary') {
                userQuery = `Rangkumkan jadwal tes ELPT ini secara terstruktur per hari beserta catatan pengawas dan ruangannya: ${JSON.stringify(scheduleData, null, 2)}`;
            } else {
                userQuery = `Analisis peserta titipan dari data jadwal tes ELPT berikut dan buat daftar nama siswa yang menitip beserta grup asal/tujuannya: ${JSON.stringify(scheduleData, null, 2)}`;
            }

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: userQuery }] }],
                        systemInstruction: { parts: [{ text: systemPrompt }] }
                    })
                });

                const result = await response.json();
                const aiText = result.candidates?.[0]?.content?.parts?.[0]?.text || "Gagal menghasilkan respon dari AI.";

                outputBox.innerText = aiText;
                outputContainer.classList.remove('hidden');
            } catch (err) {
                console.error(err);
                outputBox.innerText = "Terjadi kesalahan saat terhubung ke Gemini AI API.";
                outputContainer.classList.remove('hidden');
            } finally {
                btn.disabled = false;
                btn.innerHTML = `<i class="fa-solid fa-microchip"></i> Proses dengan Gemini AI`;
            }
        }

        function copyAiOutput() {
            const text = document.getElementById('aiOutput').innerText;
            navigator.clipboard.writeText(text);
            showToast("Teks berhasil disalin ke clipboard!", "success");
        }

        function exportToCSV() {
            if (scheduleData.length === 0) {
                showToast("Tidak ada data untuk diekspor", "error");
                return;
            }

            const headers = ["NO", "ID GRUP", "JENIS TEST", "DESCRIPTION", "INSTRUCTOR", "START DATE", "START TIME", "END DATE", "END TIME", "ROOM", "PROCTOR 1", "PROCTOR 2", "PESERTA TITIPAN"];
            const rows = scheduleData.map((d, i) => [
                i + 1,
                `"${d.idGrup}"`,
                `"${d.jenisTest}"`,
                `"${(d.description || '').replace(/"/g, '""')}"`,
                `"${d.instructor}"`,
                `"${d.startDate}"`,
                `"${d.startTime}"`,
                `"${d.endDate}"`,
                `"${d.endTime}"`,
                `"${d.room}"`,
                `"${d.proctor1}"`,
                `"${d.proctor2 || ''}"`,
                `"${(d.pesertaTitipan || '').replace(/\n/g, ' | ').replace(/"/g, '""')}"`
            ]);

            const csvContent = "data:text/csv;charset=utf-8," + [headers.join(","), ...rows.map(e => e.join(","))].join("\n");
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Jadwal_ELPT_${new Date().toISOString().split('T')[0]}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);

            showToast("File CSV berhasil diunduh!", "success");
        }

        function formatDate(dateStr) {
            if (!dateStr) return "-";
            const parts = dateStr.split("-");
            if (parts.length !== 3) return dateStr;
            const months = ["Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Agt", "Sep", "Okt", "Nov", "Des"];
            return `${parts[2]} ${months[parseInt(parts[1]) - 1]} ${parts[0]}`;
        }

        function showToast(msg, type = "success") {
            const toast = document.getElementById('toast');
            const toastMessage = document.getElementById('toastMessage');
            const toastIcon = document.getElementById('toastIcon');

            toastMessage.innerText = msg;
            
            if (type === "success") {
                toastIcon.className = "fa-solid fa-circle-check text-emerald-400 text-base";
            } else if (type === "error") {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-rose-400 text-base";
            } else {
                toastIcon.className = "fa-solid fa-circle-info text-sky-400 text-base";
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }
    </script>
