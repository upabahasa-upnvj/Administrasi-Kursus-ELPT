<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Penjadwalan Tes Kursus ELPT</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col antialiased">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white sticky top-0 z-30 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="bg-indigo-600 p-2.5 rounded-xl shadow-inner text-white">
                    <i class="fa-solid me-0 fa-graduation-cap text-xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-lg leading-tight tracking-wide">ELPT Testing Hub</h1>
                    <p class="text-xs text-slate-400">Sistem Penjadwalan Tes Kursus ELPT</p>
                </div>
            </div>

            <!-- Role Switcher & User Profile -->
            <div class="flex items-center space-x-4">
                <div id="syncStatusBadge" class="hidden sm:flex items-center text-xs font-medium text-emerald-400 bg-emerald-950/40 border border-emerald-800/50 px-3 py-1.5 rounded-lg">
                    <i class="fa-solid fa-cloud-arrow-up mr-2 text-emerald-400 animate-pulse"></i>
                    <span id="syncStatusText">Tersambung ke Google Sheet</span>
                </div>

                <div class="hidden sm:flex items-center bg-slate-800 border border-slate-700 rounded-lg p-1 text-xs">
                    <span class="px-2.5 py-1 text-slate-400 font-medium">Mode:</span>
                    <button id="roleAdminBtn" onclick="switchRole('admin')" class="px-3 py-1 rounded-md font-semibold transition-all bg-indigo-600 text-white shadow-sm">
                        <i class="fa-solid fa-user-gear mr-1"></i> Admin
                    </button>
                    <button id="roleInstructorBtn" onclick="switchRole('instructor')" class="px-3 py-1 rounded-md font-semibold text-slate-300 hover:text-white transition-all">
                        <i class="fa-solid fa-chalkboard-user mr-1"></i> Instruktur
                    </button>
                </div>

                <div class="flex items-center border-l border-slate-700 pl-4 space-x-2">
                    <span id="roleBadge" class="bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-xs px-2.5 py-1 rounded-full font-medium flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="roleLabelText">Akses Admin</span>
                    </span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main App Container -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 w-full space-y-6">

        <!-- Stat Cards Summary -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Jadwal Tes</p>
                    <h3 id="statTotalJadwal" class="text-2xl font-bold text-slate-900 mt-1">0</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Sesi Terdaftar</p>
                </div>
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-calendar-check"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Final Test</p>
                    <h3 id="statFinalTest" class="text-2xl font-bold text-indigo-600 mt-1">0</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Ujian Utama</p>
                </div>
                <div class="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-award"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Remedial Test</p>
                    <h3 id="statRemedialTest" class="text-2xl font-bold text-amber-600 mt-1">0</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Ujian Susulan/Remidi</p>
                </div>
                <div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-rotate-right"></i>
                </div>
            </div>

            <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
                <div>
                    <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Peserta Titipan</p>
                    <h3 id="statPesertaTitipan" class="text-2xl font-bold text-emerald-600 mt-1">0</h3>
                    <p class="text-xs text-slate-400 mt-0.5">Siswa Lintas Grup</p>
                </div>
                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-xl flex items-center justify-center text-xl">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
            </div>
        </div>

        <!-- Action Toolbar & Search Filters -->
        <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
            <div class="flex flex-col lg:flex-row gap-4 items-stretch lg:items-center justify-between">
                
                <!-- Search Box & Filters -->
                <div class="flex flex-wrap items-center gap-3 flex-1">
                    <!-- Search Input -->
                    <div class="relative min-w-[240px] flex-1">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" id="searchInput" oninput="applyFilters()" placeholder="Cari ID Grup, Instruktur, Ruangan..." 
                               class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all">
                    </div>

                    <!-- Filter Jenis Test -->
                    <select id="filterJenisTest" onchange="applyFilters()" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        <option value="ALL">Semua Jenis Test</option>
                        <option value="Final Test">Final Test</option>
                        <option value="Remedial Test">Remedial Test</option>
                    </select>

                    <!-- Filter Ruangan -->
                    <select id="filterRoom" onchange="applyFilters()" class="bg-slate-50 border border-slate-200 text-slate-700 text-sm rounded-xl px-3 py-2 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        <option value="ALL">Semua Ruangan</option>
                    </select>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-2 flex-wrap justify-end">
                    <!-- Admin Master Data Buttons -->
                    <div id="adminMasterButtons" class="flex items-center gap-2">
                        <button onclick="openInstructorModal()" title="Kelola Instruktur" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-sm font-medium px-3 py-2 rounded-xl transition-all flex items-center gap-1.5">
                            <i class="fa-solid fa-chalkboard-user text-indigo-600"></i>
                            <span class="hidden md:inline">Instruktur</span>
                        </button>
                        <button onclick="openStudentModal()" title="Kelola Peserta Kursus" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-sm font-medium px-3 py-2 rounded-xl transition-all flex items-center gap-1.5">
                            <i class="fa-solid fa-user-graduate text-emerald-600"></i>
                            <span class="hidden md:inline">Peserta Kursus</span>
                        </button>
                    </div>

                    <!-- Check Conflict Button -->
                    <button onclick="checkConflicts()" class="bg-slate-100 hover:bg-amber-50 text-slate-700 hover:text-amber-700 border border-slate-200 hover:border-amber-300 text-sm font-medium px-3.5 py-2 rounded-xl transition-all flex items-center gap-2">
                        <i class="fa-solid fa-triangle-exclamation text-amber-500"></i>
                        <span>Cek Bentrok</span>
                    </button>

                    <!-- Gemini AI Assistant Button -->
                    <button onclick="openAiModal()" class="bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-700 hover:to-indigo-700 text-white text-sm font-medium px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        <span>Asisten AI</span>
                    </button>

                    <!-- Manual Save to Google Sheets Button -->
                    <button onclick="saveToGoogleSheets()" title="Simpan Permanen ke Google Sheets" class="bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium px-3.5 py-2 rounded-xl transition-all shadow-sm flex items-center gap-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Simpan ke Sheet</span>
                    </button>

                    <!-- Integration Setup Button -->
                    <button onclick="openSheetsModal()" title="Pengaturan URL Google Sheets" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-sm font-medium px-3 py-2 rounded-xl transition-all flex items-center gap-1.5">
                        <i class="fa-solid fa-gear text-slate-600"></i>
                    </button>

                    <!-- Export CSV Button -->
                    <button onclick="exportToCSV()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-200 text-sm font-medium px-3.5 py-2 rounded-xl transition-all flex items-center gap-2">
                        <i class="fa-solid fa-file-excel text-emerald-600"></i>
                        <span>Ekspor CSV</span>
                    </button>

                    <!-- Add Schedule Button -->
                    <button id="addScheduleBtn" onclick="openFormModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold px-4 py-2 rounded-xl shadow-md hover:shadow-indigo-500/20 transition-all flex items-center gap-2">
                        <i class="fa-solid fa-circle-plus"></i>
                        <span>Tambah Jadwal</span>
                    </button>
                </div>
            </div>
        </div>

        <!-- Schedule Data Table -->
        <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
            <div class="overflow-x-auto custom-scrollbar">
                <table class="w-full text-left border-collapse min-w-[1100px]">
                    <thead>
                        <tr class="bg-slate-50/80 border-b border-slate-200 text-xs font-bold text-slate-500 uppercase tracking-wider">
                            <th class="py-3.5 px-4 w-12 text-center">NO</th>
                            <th class="py-3.5 px-4">EVENT & GRUP</th>
                            <th class="py-3.5 px-4">INSTRUCTOR</th>
                            <th class="py-3.5 px-4">WAKTU & TANGGAL</th>
                            <th class="py-3.5 px-4">ROOM</th>
                            <th class="py-3.5 px-4">PROCTORS</th>
                            <th class="py-3.5 px-4 text-center">PESERTA TITIPAN</th>
                            <th class="py-3.5 px-4 text-center w-28">AKSI</th>
                        </tr>
                    </thead>
                    <tbody id="scheduleTableBody" class="divide-y divide-slate-100 text-sm">
                        <!-- Table rows populated dynamically -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden py-12 text-center space-y-3">
                <div class="w-16 h-16 bg-slate-100 rounded-full flex items-center justify-center mx-auto text-slate-400 text-2xl">
                    <i class="fa-solid fa-calendar-xmark"></i>
                </div>
                <h4 class="font-semibold text-slate-700">Belum ada jadwal ditemukan</h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">Coba sesuaikan kata kunci pencarian atau tambahkan jadwal tes baru ke dalam sistem.</p>
            </div>
        </div>
    </main>

    <!-- Form Modal (Add / Edit) -->
    <div id="formModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] flex flex-col overflow-hidden transform transition-all">
            
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-calendar-plus text-indigo-400 text-lg"></i>
                    <h3 id="modalTitle" class="font-bold text-base">Tambah Jadwal Tes Baru</h3>
                </div>
                <button onclick="closeFormModal()" class="text-slate-400 hover:text-white transition-colors w-8 h-8 rounded-lg flex items-center justify-center hover:bg-slate-800">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="scheduleForm" onsubmit="handleFormSubmit(event)" class="p-6 overflow-y-auto custom-scrollbar space-y-4 text-sm flex-1">
                <input type="hidden" id="editScheduleId">

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">ID Grup <span class="text-rose-500">*</span></label>
                        <input type="text" id="idGrup" required placeholder="Contoh: ELPT-2026-A1" 
                               class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">Jenis Test <span class="text-rose-500">*</span></label>
                        <select id="jenisTest" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                            <option value="Final Test">Final Test</option>
                            <option value="Remedial Test">Remedial Test</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-medium text-slate-700 mb-1">Deskripsi / Keterangan</label>
                    <textarea id="description" rows="2" placeholder="Sebutkan cakupan materi atau catatan pelaksanaan tes..." 
                              class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500"></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">Instructor (Pengampu) <span class="text-rose-500">*</span></label>
                        <select id="instructor" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white">
                        </select>
                    </div>
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">Ruangan / Room <span class="text-rose-500">*</span></label>
                        <input type="text" id="room" required placeholder="Lab Bahasa 1 / Zoom Room A" 
                               class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                    </div>
                </div>

                <div class="p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3">
                    <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">Waktu Pelaksanaan</p>
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Mulai <span class="text-rose-500">*</span></label>
                            <input type="date" id="startDate" required class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Jam Mulai <span class="text-rose-500">*</span></label>
                            <input type="time" id="startTime" required class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Tanggal Selesai <span class="text-rose-500">*</span></label>
                            <input type="date" id="endDate" required class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-600 mb-1">Jam Selesai <span class="text-rose-500">*</span></label>
                            <input type="time" id="endTime" required class="w-full px-3 py-1.5 border border-slate-200 rounded-lg text-sm bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">Proctor 1 (Instruktur Utama) <span class="text-rose-500">*</span></label>
                        <select id="proctor1" required class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white">
                        </select>
                    </div>
                    <div>
                        <label class="block font-medium text-slate-700 mb-1">Proctor 2 (Pendamping)</label>
                        <select id="proctor2" class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 bg-white">
                        </select>
                    </div>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="block font-medium text-slate-700">
                            Peserta Titipan <span class="text-xs font-normal text-slate-400">(NIM, Nama, Grup)</span>
                        </label>
                        <button type="button" onclick="openSelectStudentPicker()" class="text-xs text-indigo-600 hover:text-indigo-800 font-medium flex items-center gap-1 bg-indigo-50 px-2.5 py-1 rounded-lg border border-indigo-100 transition-colors">
                            <i class="fa-solid fa-user-plus text-[10px]"></i> Pilih dari Master Peserta
                        </button>
                    </div>
                    <textarea id="pesertaTitipan" rows="3" placeholder="Contoh format per baris:&#10;21010150 - Ahmad Rizky - ELPT-B2&#10;21010188 - Dewi Lestari - ELPT-C1" 
                              class="w-full px-3.5 py-2 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 font-mono text-xs"></textarea>
                </div>

                <div class="pt-4 border-t border-slate-100 flex items-center justify-end space-x-3">
                    <button type="button" onclick="closeFormModal()" class="px-4 py-2 border border-slate-200 text-slate-600 rounded-xl hover:bg-slate-100 font-medium text-sm transition-colors">
                        Batal
                    </button>
                    <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-semibold text-sm transition-all shadow-md">
                        Simpan Jadwal
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Detail Modal -->
    <div id="detailModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden flex flex-col">
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-users text-indigo-400"></i>
                    <h3 class="font-bold text-base">Detail Peserta Titipan & Sesi</h3>
                </div>
                <button onclick="closeDetailModal()" class="text-slate-400 hover:text-white transition-colors">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 space-y-4 text-xs">
                <div class="flex justify-between items-start border-b border-slate-100 pb-3">
                    <div>
                        <div class="flex items-center space-x-2">
                            <h4 id="detailIdGrup" class="font-bold text-base text-slate-900"></h4>
                            <span id="detailEventBadge"></span>
                        </div>
                        <p id="detailDescription" class="text-slate-500 mt-1"></p>
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-2 text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200">
                    <div><span class="text-slate-400">Instruktur:</span> <strong id="detailInstructor" class="block font-semibold"></strong></div>
                    <div><span class="text-slate-400">Ruangan:</span> <strong id="detailRoom" class="block font-semibold"></strong></div>
                    <div class="mt-1"><span class="text-slate-400">Pengawas 1:</span> <span id="detailProctor1" class="block font-medium"></span></div>
                    <div class="mt-1"><span class="text-slate-400">Pengawas 2:</span> <span id="detailProctor2" class="block font-medium"></span></div>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-2">
                        <label class="font-bold uppercase tracking-wider text-slate-600">Daftar Peserta Titipan</label>
                        <span id="detailPesertaCount" class="bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-semibold"></span>
                    </div>
                    <div id="detailPesertaList" class="space-y-1.5 max-h-48 overflow-y-auto custom-scrollbar font-mono">
                    </div>
                </div>
            </div>
            <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end">
                <button onclick="closeDetailModal()" class="px-4 py-2 bg-slate-800 text-white font-semibold rounded-xl text-xs hover:bg-slate-900 transition-colors">
                    Tutup
                </button>
            </div>
        </div>
    </div>

    <!-- Instructor Master Modal -->
    <div id="instructorModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
        <div class="bg-white rounded-2xl shadow-2xl w-full max-w-3xl max-h-[90vh] flex flex-col overflow-hidden">
            <div class="px-6 py-4 bg-slate-900 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-chalkboard-user text-indigo-400 text-lg"></i>
